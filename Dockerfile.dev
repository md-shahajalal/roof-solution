FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
EXPOSE 4200
# --poll: inotify does not cross the bind mount reliably on Docker Desktop
# (Windows and macOS), so file watching needs polling to pick up your edits.
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "1500"]
